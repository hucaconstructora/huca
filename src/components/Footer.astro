---
import logo from '@/assets/site/logo-huca.svg';
import footerPattern from '@/assets/site/footer-pattern-4.svg';
import Phone from 'remixicon/icons/Device/phone-line.svg';
import Mail from 'remixicon/icons/Business/mail-line.svg';
import MapPin from 'remixicon/icons/Map/map-pin-2-line.svg';
import Clock from 'remixicon/icons/System/time-line.svg';
import ChevronRight from 'remixicon/icons/Arrows/arrow-right-s-line.svg';
import { companyProfile } from '@/data/company';
import { getCollection } from 'astro:content';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const currentYear = new Date().getFullYear();
---

<footer class="site-footer" style={`--footer-pattern: url("${footerPattern.src}")`}>
  <div class="footer-main">
    <div class="container footer-grid">
      <div class="footer-brand">
        <a href="/" aria-label="HUCA Building Solutions — Inicio">
          <img src={logo.src} alt="HUCA Building Solutions" width={150} height={133} loading="lazy" />
        </a>
        <p>Construcción, obra civil y reformas integrales en Barcelona.</p>
      </div>

      <div class="footer-links" aria-label="Contenido del sitio">
        <h2>Contenido</h2>
        <div class="footer-links__grid">
          <nav class="footer-links__column">
            <a class="footer-links__item" href="/empresa/"><ChevronRight width={12} height={12} aria-hidden="true" /> Quiénes somos</a>
            <a class="footer-links__item" href="/por-que-elegirnos/"><ChevronRight width={12} height={12} aria-hidden="true" /> Por qué elegir HUCA</a>
            <a class="footer-links__item" href="/proyectos/"><ChevronRight width={12} height={12} aria-hidden="true" /> Proyectos</a>
            <a class="footer-links__item" href="/contacto/"><ChevronRight width={12} height={12} aria-hidden="true" /> Contacto</a>
          </nav>
          <nav class="footer-links__column">
            <a class="footer-links__item" href="/servicios/"><ChevronRight width={12} height={12} aria-hidden="true" /> Servicios</a>
            {services.map((service) => (
              <a class="footer-links__item footer-links__sub" href={`/service/${service.data.slug}/`}><ChevronRight width={12} height={12} aria-hidden="true" /> {service.data.title}</a>
            ))}            
          </nav>
        </div>
      </div>

      <div class="footer-contact">
        <h2>Contacto</h2>
        <address class="footer-contact__item"><MapPin width={16} height={16} aria-hidden="true" /> {companyProfile.address}</address>
        {companyProfile.phones.filter((phone) => phone.label !== '663.275.750').map((phone) => (
          <a class="footer-contact__item" href={phone.href}><Phone width={16} height={16} aria-hidden="true" /> {phone.label}</a>
        ))}
        <a class="footer-contact__item" href={`mailto:${companyProfile.email}`}><Mail width={16} height={16} aria-hidden="true" /> {companyProfile.email}</a>
        <p class="footer-contact__item"><Clock width={16} height={16} aria-hidden="true" /> Horario: {companyProfile.hours}</p>
      </div>
    </div>

    <div class="container footer-bottom">
      <p>Copyright © {currentYear} <strong>{companyProfile.legalName}</strong>.</p>
      <nav aria-label="Información legal">
        <a href="/aviso-legal/">Aviso legal</a>
        <a href="/politica-de-privacidad/">Política de privacidad</a>
        <a href="/politica-de-cookies/">Política de cookies</a>
      </nav>
      <a href="https://tau.studio" target="_blank" rel="noopener noreferrer" aria-label="Desarrollado por Tau Studio"
         style="display:inline-flex;align-items:center;gap:.45rem;font-size:.8125rem;font-weight:500;text-decoration:none;color:inherit;opacity:.65;">
        <img src="https://tau.studio/tau.svg" alt="Tau Studio" width="18" height="18" loading="lazy" decoding="async" />
        <span>Desarrollado por Tau Studio</span>
      </a>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    color: #cdcdcd;
    background-color: var(--color-charcoal);
    position: relative;
    overflow: hidden;
  }

  .site-footer::before {
    content: '';
    position: absolute;
    top: -20%;
    left: 10%;
    width: 60%;
    height: 140%;
    background: var(--footer-pattern) left top / 400px auto no-repeat;
    opacity: 0.15;
    transform: rotate(15deg);
    transform-origin: left top;
    pointer-events: none;
    z-index: 0;
  }

  .site-footer > * {
    position: relative;
    z-index: 1;
  }

  .footer-main {
    padding: 52px 0 24px;
    background: rgb(18 19 21 / 28%);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1.1fr;
    gap: clamp(40px, 5vw, 80px);
  }

  .footer-brand > a :global(img) {
    width: 130px;
    height: auto;
    margin-bottom: 24px;
  }

  .footer-brand p,
  .footer-contact,
  .footer-links {
    font-size: 15px;
    line-height: 1.65;
  }

  .footer-brand p {
    max-width: 320px;
    color: #cfcfcf;
  }

  .footer-grid h2 {
    margin: 3px 0 20px;
    color: white;
    font-size: 18px;
    line-height: 1.3;
  }

  .footer-links,
  .footer-contact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 9px;
  }

  .footer-links__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 9px 32px;
  }

  .footer-links__column {
    display: flex;
    flex-direction: column;
    gap: 9px;
  }

  .footer-links__item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }

  .footer-links__item :global(svg) {
    flex: 0 0 12px;
    color: var(--color-accent);
  }

  .footer-links__item:hover {
    color: var(--color-accent);
  }

  .footer-contact__item {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }

  .footer-contact__item :global(svg) {
    flex: 0 0 16px;
    color: var(--color-accent);
  }

  .footer-contact address {
    max-width: 280px;
    margin-bottom: 4px;
    font-style: normal;
  }

  .footer-links a,
  .footer-contact a,
  .footer-bottom a {
    color: #cfcfcf;
    transition: color 160ms ease;
  }

  .footer-links a:hover,
  .footer-contact a:hover,
  .footer-bottom a:hover {
    color: var(--color-accent);
  }

  .footer-links__sub {
    padding-left: 12px;
    color: #a9a9a9 !important;
    font-size: 13px;
  }

  .footer-contact p {
    margin-top: 5px;
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 45px;
    padding-top: 18px;
    border-top: 1px solid rgb(255 255 255 / 12%);
    color: #cfcfcf;
    font-size: 13px;
  }

  .footer-bottom nav {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
  }

  @media (max-width: 800px) {
    .footer-cta__inner {
      align-items: flex-start;
      flex-direction: column;
    }

    .footer-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 40px 30px;
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 560px) {
    .footer-grid {
      grid-template-columns: 1fr;
      gap: 34px;
    }

    .footer-brand {
      grid-column: auto;
    }

    .footer-bottom {
      align-items: flex-start;
      flex-direction: column;
      margin-top: 32px;
    }

    .footer-bottom nav {
      gap: 12px 18px;
    }
  }
</style>
