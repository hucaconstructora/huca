---
import { getCollection } from 'astro:content';
import logo from '@/assets/site/logo-huca.svg';
import Phone from 'remixicon/icons/Device/phone-fill.svg';
import ChevronDown from 'remixicon/icons/Arrows/arrow-down-s-line.svg';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const pathname = Astro.url.pathname;
const companyActive = pathname.startsWith('/empresa/') || pathname.startsWith('/por-que-elegirnos/');
const servicesActive = pathname.startsWith('/servicios/') || pathname.startsWith('/service/');
---

<header class="site-header">
  <div class="site-header__inner">
    <a class="site-brand" href="/" aria-label="HUCA Building Solutions — Inicio">
      <img src={logo.src} alt="HUCA Building Solutions" width={128} height={113} loading="eager" />
    </a>

    <button
      class="site-menu-toggle"
      type="button"
      aria-label="Abrir menú de navegación"
      aria-controls="site-navigation"
      aria-expanded="false"
      data-menu-toggle
    >
      <span></span><span></span><span></span>
    </button>

    <div class="site-nav-backdrop" data-menu-backdrop aria-hidden="true"></div>

    <nav class="site-nav" id="site-navigation" aria-label="Navegación principal" data-site-nav>
      <a class="site-nav__link" href="/" aria-current={pathname === '/' ? 'page' : undefined}>Inicio</a>

      <div class:list={['site-nav__dropdown', companyActive && 'is-active']} data-dropdown>
        <button type="button" class="site-nav__dropdown-toggle" aria-expanded="false" aria-haspopup="true">
          Empresa <ChevronDown width={14} height={14} class="site-nav__chevron" aria-hidden="true" />
        </button>
        <div class="site-nav__submenu" hidden>
          <a href="/empresa/">Quiénes somos</a>
          <a href="/por-que-elegirnos/">Por qué elegir HUCA</a>
        </div>
      </div>

      <div class:list={['site-nav__dropdown', servicesActive && 'is-active']} data-dropdown>
        <button type="button" class="site-nav__dropdown-toggle" aria-expanded="false" aria-haspopup="true">
          Servicios <ChevronDown width={14} height={14} class="site-nav__chevron" aria-hidden="true" />
        </button>
        <div class="site-nav__submenu" hidden>
          <a href="/servicios/">Todos los servicios</a>
          {services.map((service) => (
            <a href={`/service/${service.data.slug}/`}>{service.data.title}</a>
          ))}
        </div>
      </div>

      <a
        class="site-nav__link"
        href="/proyectos/"
        aria-current={pathname.startsWith('/proyectos/') ? 'page' : undefined}
      >
        Proyectos
      </a>
      <a
        class="site-nav__link"
        href="/contacto/"
        aria-current={pathname.startsWith('/contacto/') ? 'page' : undefined}
      >
        Contacto
      </a>

      <a class="site-nav__phone" href="tel:+34671774262">
        <span class="site-nav__phone-icon" aria-hidden="true">
          <Phone width={20} height={20} />
        </span>
        <span class="site-nav__phone-copy">
          <span>Contáctanos</span>
          <strong>+34 671.774.262</strong>
        </span>
      </a>
    </nav>

    <a class="site-header__phone" href="tel:+34671774262">
      <span class="site-header__phone-icon" aria-hidden="true">
        <Phone width={20} height={20} />
      </span>
      <span class="site-header__phone-copy">
        <span>Contáctanos</span>
        <strong>+34 671.774.262</strong>
      </span>
    </a>
  </div>
</header>

<script>
  const siteDropdowns = Array.from(document.querySelectorAll('[data-dropdown]'));

  const closeAllDropdowns = () => {
    siteDropdowns.forEach((dropdown) => {
      dropdown.classList.remove('is-open');
      const toggle = dropdown.querySelector('.site-nav__dropdown-toggle');
      const submenu = dropdown.querySelector('.site-nav__submenu') as HTMLElement | null;
      toggle?.setAttribute('aria-expanded', 'false');
      if (submenu) submenu.hidden = true;
    });
  };

  siteDropdowns.forEach((dropdown) => {
    const toggle = dropdown.querySelector('.site-nav__dropdown-toggle');
    const submenu = dropdown.querySelector('.site-nav__submenu') as HTMLElement | null;
    if (!toggle || !submenu) return;

    toggle.addEventListener('click', (event) => {
      event.stopPropagation();
      const willOpen = !dropdown.classList.contains('is-open');
      closeAllDropdowns();
      if (willOpen) {
        dropdown.classList.add('is-open');
        toggle.setAttribute('aria-expanded', 'true');
        submenu.hidden = false;
      }
    });
  });

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element) || !target.closest('[data-dropdown]')) {
      closeAllDropdowns();
    }
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeAllDropdowns();
  });

  document.querySelectorAll('.site-nav__submenu a').forEach((link) => {
    link.addEventListener('click', () => {
      closeAllDropdowns();
    });
  });

  const setMenuState = (header: Element | null, toggle: Element | null, open: boolean) => {
    if (!header || !toggle) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');
    header.classList.toggle('is-open', open);
    document.body.style.overflow = open ? 'hidden' : '';
    if (!open) closeAllDropdowns();
  };

  document.querySelectorAll('[data-menu-toggle]').forEach((button) => {
    button.addEventListener('click', () => {
      const header = button.closest('.site-header');
      const open = button.getAttribute('aria-expanded') !== 'true';
      setMenuState(header, button, open);
    });
  });

  document.querySelectorAll('[data-menu-backdrop]').forEach((backdrop) => {
    backdrop.addEventListener('click', () => {
      const header = backdrop.closest('.site-header');
      const toggle = header?.querySelector('[data-menu-toggle]') ?? null;
      setMenuState(header ?? null, toggle, false);
    });
  });

  document.querySelectorAll('[data-site-nav] a').forEach((link) => {
    link.addEventListener('click', () => {
      const header = link.closest('.site-header');
      const toggle = header?.querySelector('[data-menu-toggle]') ?? null;
      setMenuState(header ?? null, toggle, false);
    });
  });

  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape') return;
    document.querySelectorAll('.site-header.is-open').forEach((header) => {
      const toggle = header.querySelector('[data-menu-toggle]');
      setMenuState(header, toggle, false);
    });
  });

  document.addEventListener('click', (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;
    document.querySelectorAll('.site-header.is-open').forEach((header) => {
      if (!target.closest('[data-site-nav]') && !target.closest('[data-menu-toggle]') && !target.closest('[data-menu-backdrop]')) {
        const toggle = header.querySelector('[data-menu-toggle]');
        setMenuState(header, toggle, false);
      }
    });
  });

  window.addEventListener('resize', () => {
    if (window.innerWidth > 1023) {
      document.querySelectorAll('.site-header.is-open').forEach((header) => {
        const toggle = header.querySelector('[data-menu-toggle]');
        setMenuState(header, toggle, false);
      });
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    z-index: 50;
    top: 0;
    background: var(--color-paper);
    box-shadow: 0 2px 18px rgb(18 19 21 / 7%);
  }

  .site-header__inner {
    display: flex;
    min-height: 90px;
    align-items: stretch;
  }

  .site-brand {
    display: grid;
    width: 90px;
    flex: 0 0 90px;
    place-items: center;
    padding: 8px;
    background: #1e2023;
    aspect-ratio: 1 / 1;
    align-self: stretch;
    margin: 0;
  }

  .site-brand :global(img) {
    width: 60px;
    height: auto;
  }

  .site-nav {
    display: flex;
    min-width: 0;
    flex: 1 1 auto;
    align-items: stretch;
    justify-content: center;
    gap: clamp(14px, 2.1vw, 34px);
    padding: 0 28px;
  }

  .site-nav__link,
  .site-nav__dropdown-toggle {
    display: inline-flex;
    height: 100%;
    min-height: 48px;
    align-items: center;
    gap: 7px;
    border: 0;
    background: transparent;
    color: var(--color-ink);
    cursor: pointer;
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    transition: color 180ms ease;
  }

  .site-nav__link:hover,
  .site-nav__dropdown-toggle:hover {
    color: var(--color-accent);
  }

  .site-nav__link[aria-current='page'],
  .site-nav__dropdown.is-active .site-nav__dropdown-toggle {
    color: var(--color-accent);
    position: relative;
  }

  .site-nav__link[aria-current='page']::after,
  .site-nav__dropdown.is-active .site-nav__dropdown-toggle::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 4px;
    background: var(--color-accent);
  }

  .site-nav__dropdown {
    position: relative;
    height: auto;
    overflow: visible;
  }

  .site-nav__chevron {
    color: var(--color-accent);
    font-size: 16px;
    line-height: 1;
    transition: transform 180ms ease;
  }

  .site-nav__dropdown.is-open .site-nav__chevron {
    transform: rotate(180deg);
  }

  .site-nav__submenu {
    position: absolute;
    z-index: 55;
    top: calc(100% - 4px);
    left: -20px;
    display: none;
    min-width: 240px;
    padding: 10px 0;
    background: var(--color-charcoal);
    box-shadow: var(--shadow-soft);
  }

  .site-nav__dropdown.is-open .site-nav__submenu {
    display: grid;
  }

  .site-nav__submenu a {
    display: block;
    padding: 12px 20px;
    color: #eee;
    font-size: 15px;
    line-height: 1.3;
    transition: color 160ms ease, background-color 160ms ease;
  }

  .site-nav__submenu a:hover,
  .site-nav__submenu a:focus-visible {
    background: rgb(255 255 255 / 5%);
    color: var(--color-accent);
  }

  .site-header__phone {
    display: flex;
    min-width: 248px;
    align-items: center;
    gap: 15px;
    padding: 0 24px;
    background: var(--color-charcoal);
    color: var(--color-paper);
  }

  .site-header__phone-icon {
    display: grid;
    width: 52px;
    height: 52px;
    flex: 0 0 52px;
    place-items: center;
    background: var(--color-accent);
  }

  .site-header__phone-icon svg {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  .site-header__phone-copy {
    display: grid;
    gap: 3px;
  }

  .site-header__phone-copy span {
    color: #c6c6c6;
    font-size: 13px;
  }

  .site-header__phone-copy strong {
    color: #fff;
    font-family: var(--font-heading);
    font-size: 18px;
    font-weight: 700;
    white-space: nowrap;
  }

  .site-menu-toggle {
    display: none;
  }

  .site-nav-backdrop {
    display: none;
  }

  .site-nav__phone {
    display: none;
  }

  @media (max-width: 1200px) {
    .site-header__inner {
      min-height: 90px;
    }

    .site-brand {
      width: 90px;
      flex-basis: 90px;
      padding: 8px;
    }

    .site-brand :global(img) {
      width: 60px;
    }

    .site-nav {
      gap: 15px;
      padding-inline: 18px;
    }

    .site-nav__link,
    .site-nav__dropdown-toggle {
      font-size: 11px;
      letter-spacing: 0.07em;
    }

    .site-header__phone {
      min-width: 215px;
      padding-inline: 16px;
    }

    .site-header__phone-icon {
      width: 44px;
      height: 44px;
      flex-basis: 44px;
    }

    .site-header__phone-copy strong {
      font-size: 16px;
    }
  }

  @media (width <= 1023px) {
    .site-header__inner {
      position: relative;
      height: 82px;
      min-height: 82px;
      align-items: center;
      padding: 0;
      background: #1e2023;
    }

    .site-brand {
      width: 82px;
      height: 82px;
      flex-basis: 82px;
      padding: 8px;
      background: #1e2023;
      aspect-ratio: 1 / 1;
    }

    .site-brand :global(img) {
      width: 54px;
      height: auto;
    }

    .site-menu-toggle {
      display: flex;
      width: 82px;
      height: 82px;
      flex: 0 0 82px;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 6px;
      order: 3;
      border: 0;
      background: var(--color-accent);
      cursor: pointer;
    }

    .site-menu-toggle span {
      width: 25px;
      height: 2px;
      background: white;
      transition: transform 180ms ease, opacity 180ms ease;
    }

    .site-header.is-open .site-menu-toggle span:first-child {
      transform: translateY(8px) rotate(45deg);
    }

    .site-header.is-open .site-menu-toggle span:nth-child(2) {
      opacity: 0;
    }

    .site-header.is-open .site-menu-toggle span:last-child {
      transform: translateY(-8px) rotate(-45deg);
    }

    .site-header__phone {
      display: none;
    }

    .site-menu-toggle {
      margin-left: auto;
    }

    .site-nav-backdrop {
      position: fixed;
      top: 82px;
      right: 0;
      bottom: 0;
      left: 0;
      background: rgb(18 19 21 / 55%);
      backdrop-filter: blur(2px);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 220ms ease, visibility 220ms ease;
      z-index: 59;
    }

    .site-header.is-open .site-nav-backdrop {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .site-nav {
      position: fixed;
      z-index: 60;
      top: 82px;
      right: 0;
      left: 0;
      width: 100%;
      max-height: calc(100vh - 82px);
      overflow-y: auto;
      overflow-x: hidden;
      overscroll-behavior: contain;
      display: grid;
      grid-template-columns: 1fr;
      gap: 0;
      padding: 8px 0 24px;
      background: var(--color-charcoal);
      box-shadow: 0 18px 40px rgb(18 19 21 / 35%);
      transform: translateY(-12px);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: transform 240ms ease, opacity 240ms ease, visibility 240ms ease;
    }

    .site-header.is-open .site-nav {
      transform: translateY(0);
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }

    .site-nav__phone {
      display: flex;
      align-items: center;
      gap: 12px;
      margin: 16px var(--page-gutter) 0;
      padding: 14px 16px;
      background: var(--color-accent);
      color: var(--color-paper);
      font-family: var(--font-heading);
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.05em;
      text-transform: uppercase;
    }

    .site-nav__phone-icon {
      display: grid;
      width: 40px;
      height: 40px;
      flex: 0 0 40px;
      place-items: center;
      background: var(--color-charcoal);
      color: var(--color-paper);
    }

    .site-nav__phone-icon svg {
      width: 18px;
      height: 18px;
      fill: currentColor;
    }

    .site-nav__phone-copy {
      display: grid;
      gap: 2px;
      line-height: 1.1;
    }

    .site-nav__phone-copy span {
      font-size: 10px;
      color: rgb(255 255 255 / 75%);
      letter-spacing: 0.1em;
    }

    .site-nav__phone-copy strong {
      font-size: 14px;
      font-weight: 700;
      color: var(--color-paper);
      white-space: nowrap;
    }

    .site-nav__link,
    .site-nav__dropdown-toggle {
      height: auto;
      min-height: 52px;
      justify-content: space-between;
      padding-inline: var(--page-gutter);
      border-bottom: 1px solid rgb(255 255 255 / 10%);
      color: white;
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      width: 100%;
      text-align: left;
      transition: background-color 160ms ease, color 160ms ease;
    }

    .site-nav__link:hover,
    .site-nav__dropdown-toggle:hover {
      background: rgb(255 255 255 / 4%);
      color: var(--color-accent);
    }

    .site-nav__link[aria-current='page'],
    .site-nav__dropdown.is-active .site-nav__dropdown-toggle {
      color: var(--color-accent);
    }

    .site-nav__dropdown {
      width: 100%;
    }

    .site-nav__submenu {
      position: static;
      width: 100%;
      min-width: 0;
      padding: 4px var(--page-gutter) 8px var(--page-gutter);
      background: rgb(255 255 255 / 6%);
      box-shadow: none;
      display: none;
      overflow: hidden;
    }

    .site-nav__dropdown.is-open .site-nav__submenu {
      display: grid;
    }

    .site-nav__submenu a {
      display: block;
      padding: 10px 8px;
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.08em;
      color: rgb(255 255 255 / 75%);
      transition: color 160ms ease, background-color 160ms ease;
    }

    .site-nav__submenu a:hover,
    .site-nav__submenu a:focus-visible {
      color: var(--color-accent);
      background: rgb(255 255 255 / 4%);
    }

    .site-header__phone {
      min-width: 0;
      flex: 1 1 auto;
      justify-content: flex-end;
      padding-inline: 18px;
      background: var(--color-charcoal);
      color: var(--color-paper);
      min-height: 82px;
    }

    .site-header__phone-copy span {
      color: var(--color-muted);
    }

    .site-header__phone-copy strong {
      color: var(--color-paper);
    }
  }

  @media (width <= 560px) {
    .site-header__inner {
      min-height: 62px;
      height: 62px;
    }

    .site-nav-backdrop,
    .site-nav {
      top: 62px;
    }

    .site-nav {
      max-height: calc(100vh - 62px);
    }

    .site-brand {
      width: 62px;
      height: 62px;
      flex-basis: 62px;
      background: #1e2023;
      aspect-ratio: 1 / 1;
    }

    .site-brand :global(img) {
      width: 46px;
    }

    .site-menu-toggle {
      width: 62px;
      height: 62px;
      flex-basis: 62px;
    }

    .site-header__phone {
      gap: 8px;
      padding: 10px 8px;
      min-height: 62px;
    }

    .site-header__phone-icon {
      width: 38px;
      height: 38px;
      flex-basis: 38px;
    }

    .site-header__phone-copy span {
      font-size: 10px;
    }

    .site-header__phone-copy strong {
      font-size: 12px;
    }
  }
</style>
