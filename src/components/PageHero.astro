---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import blueprint from '../assets/site/blueprint-pattern.webp';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  image: ImageMetadata;
  imageAlt: string;
  tone?: 'accent' | 'dark';
  breadcrumbs?: Crumb[];
}

const {
  eyebrow,
  title,
  description,
  image,
  imageAlt,
  tone = 'accent',
  breadcrumbs = [],
} = Astro.props;
---

<section class:list={['page-hero', `page-hero--${tone}`]}>
  <div class="page-hero__copy" style={`--hero-pattern: url("${blueprint.src}")`}>
    <div class="page-hero__copy-inner">
      <p class="eyebrow eyebrow--light">{eyebrow}</p>
      <h1>{title}</h1>
      {description && <p class="page-hero__description">{description}</p>}

      {breadcrumbs.length > 0 && (
        <nav class="page-hero__breadcrumbs" aria-label="Ruta de navegación">
          <ol>
            {breadcrumbs.map((crumb, index) => (
              <li>
                {crumb.href && index < breadcrumbs.length - 1
                  ? <a href={crumb.href}>{crumb.label}</a>
                  : <span aria-current={index === breadcrumbs.length - 1 ? 'page' : undefined}>{crumb.label}</span>}
              </li>
            ))}
          </ol>
        </nav>
      )}
    </div>
  </div>
  <div class="page-hero__media">
    <Picture
      src={image}
      alt={imageAlt}
      widths={[480, 768, 1024, 1440]}
      sizes="(max-width: 767px) 100vw, 50vw"
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      fit="cover"
      position="center"
      priority
    />
  </div>
</section>

<style>
  .page-hero {
    display: grid;
    min-height: 390px;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 0.65fr);
  }

  .page-hero--dark .page-hero__copy {
    background-color: var(--color-charcoal);
  }

  .page-hero--accent .page-hero__copy {
    background-color: var(--color-accent);
  }

  .page-hero__copy {
    position: relative;
    display: flex;
    min-width: 0;
    align-items: center;
    overflow: hidden;
    color: white;
  }

  .page-hero__copy::after {
    position: absolute;
    inset: 0;
    background-image: var(--hero-pattern);
    background-position: right bottom;
    background-repeat: no-repeat;
    background-size: min(560px, 90%) auto;
    content: '';
    opacity: 0.2;
    pointer-events: none;
  }

  .page-hero__copy-inner {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 100%;
    padding: clamp(48px, 7vw, 92px) clamp(24px, 4vw, 56px) clamp(44px, 6vw, 80px) max(var(--page-gutter), calc((100vw - var(--container)) / 2));
  }

  .page-hero h1 {
    max-width: 100%;
    margin-top: 16px;
    color: white;
    font-size: clamp(36px, 4.2vw, 58px);
    line-height: 1.12;
  }

  .page-hero__description {
    max-width: 100%;
    margin-top: 16px;
    color: rgb(255 255 255 / 92%);
    font-size: 16px;
    line-height: 1.6;
  }

  .page-hero__breadcrumbs {
    display: inline-flex;
    max-width: 100%;
    margin-top: 34px;
    padding: 0 16px;
    background: var(--color-ink);
  }

  .page-hero__breadcrumbs ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .page-hero__breadcrumbs li {
    display: flex;
    align-items: center;
    min-height: 38px;
    color: #fff;
    font-family: var(--font-heading);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.1em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .page-hero__breadcrumbs li + li::before {
    padding: 0 10px;
    color: var(--color-accent);
    content: '▪';
  }

  .page-hero__breadcrumbs a {
    color: #bdbdbd;
    transition: color 160ms ease;
  }

  .page-hero__breadcrumbs a:hover {
    color: white;
  }

  .page-hero__media {
    position: relative;
    min-height: 390px;
    overflow: hidden;
    background: #d8d8d8;
  }

  .page-hero__media :global(picture),
  .page-hero__media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .page-hero__media :global(img) {
    object-fit: cover;
  }

  .page-hero--accent .eyebrow::before,
  .page-hero--accent .eyebrow::after {
    background: white;
  }

  @media (max-width: 767px) {
    .page-hero {
      grid-template-columns: 1fr;
    }

    .page-hero__copy-inner {
      padding: 52px var(--page-gutter) 42px;
    }

    .page-hero h1 {
      font-size: clamp(34px, 9vw, 44px);
    }

    .page-hero__media {
      min-height: clamp(240px, 62vw, 380px);
    }
  }
</style>
