---
import { Picture } from 'astro:assets';
import ChevronLeft from 'remixicon/icons/Arrows/arrow-left-s-line.svg';
import ChevronRight from 'remixicon/icons/Arrows/arrow-right-s-line.svg';
import Close from 'remixicon/icons/System/close-line.svg';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const gallery = project.data.gallery;
---

<section class="project-gallery" data-project-gallery aria-label={`Galería del proyecto ${project.data.title}`}>
  <div class="project-gallery__main">
    <div class="project-gallery__viewport" data-gallery-viewport tabindex="0" aria-label="Fotografías del proyecto; usa las flechas para desplazarte">
      {gallery.map((photo, index) => (
        <figure class="project-gallery__slide" data-gallery-slide data-index={index} data-src={photo.src.src} data-alt={photo.alt}>
          <button type="button" class="project-gallery__slide-button" data-gallery-open data-index={index} aria-label={`Ampliar fotografía ${index + 1}`}>
            <Picture
              src={photo.src}
              alt={photo.alt}
              widths={[480, 768, 960, 1200]}
              sizes="(max-width: 767px) 100vw, min(100vw - 48px, 1170px)"
              formats={['avif', 'webp']}
              fallbackFormat="webp"
              fit="cover"
              loading={index === 0 ? 'eager' : 'lazy'}
              priority={index === 0}
            />
          </button>
        </figure>
      ))}
    </div>

    <div class="project-gallery__controls">
      <button type="button" data-gallery-prev aria-label="Ver fotografía anterior" disabled>
        <ChevronLeft width={20} height={20} aria-hidden="true" />
      </button>
      <button type="button" data-gallery-next aria-label="Ver fotografía siguiente">
        <ChevronRight width={20} height={20} aria-hidden="true" />
      </button>
      <span class="project-gallery__status" aria-live="polite" data-gallery-status></span>
    </div>
  </div>

  <div class="project-gallery__thumbs" data-gallery-thumbs aria-label="Listado de fotografías del proyecto">
    {gallery.map((photo, index) => (
      <button
        type="button"
        class="project-gallery__thumb"
        data-gallery-thumb
        data-index={index}
        data-src={photo.src.src}
        data-alt={photo.alt}
        aria-label={`Ver fotografía ${index + 1} en grande`}
      >
        <Picture
          src={photo.src}
          alt={photo.alt}
          widths={[96, 192]}
          sizes="96px"
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          fit="cover"
          loading="lazy"
        />
      </button>
    ))}
  </div>

  <div class="project-gallery__lightbox" data-gallery-lightbox hidden aria-hidden="true">
    <button type="button" class="project-gallery__lightbox-close" data-lightbox-close aria-label="Cerrar imagen ampliada">
      <Close width={24} height={24} aria-hidden="true" />
    </button>
    <button type="button" class="project-gallery__lightbox-nav project-gallery__lightbox-nav--prev" data-lightbox-prev aria-label="Fotografía anterior">
      <ChevronLeft width={28} height={28} aria-hidden="true" />
    </button>
    <figure class="project-gallery__lightbox-figure">
      <img class="project-gallery__lightbox-image" data-lightbox-image src="" alt="" />
      <figcaption class="project-gallery__lightbox-caption" data-lightbox-caption></figcaption>
    </figure>
    <button type="button" class="project-gallery__lightbox-nav project-gallery__lightbox-nav--next" data-lightbox-next aria-label="Fotografía siguiente">
      <ChevronRight width={28} height={28} aria-hidden="true" />
    </button>
  </div>
</section>

<script>
  document.querySelectorAll('[data-project-gallery]').forEach((gallery) => {
    const viewport = gallery.querySelector('[data-gallery-viewport]') as HTMLElement | null;
    const slides = Array.from(gallery.querySelectorAll('[data-gallery-slide]')) as HTMLElement[];
    const previous = gallery.querySelector('[data-gallery-prev]') as HTMLButtonElement | null;
    const next = gallery.querySelector('[data-gallery-next]') as HTMLButtonElement | null;
    const status = gallery.querySelector('[data-gallery-status]');
    const thumbs = Array.from(gallery.querySelectorAll('[data-gallery-thumb]')) as HTMLButtonElement[];
    const lightbox = gallery.querySelector('[data-gallery-lightbox]') as HTMLElement | null;
    const lightboxImage = gallery.querySelector('[data-lightbox-image]') as HTMLImageElement | null;
    const lightboxCaption = gallery.querySelector('[data-lightbox-caption]');
    const lightboxClose = gallery.querySelector('[data-lightbox-close]') as HTMLButtonElement | null;
    const lightboxPrev = gallery.querySelector('[data-lightbox-prev]') as HTMLButtonElement | null;
    const lightboxNext = gallery.querySelector('[data-lightbox-next]') as HTMLButtonElement | null;
    const openButtons = Array.from(gallery.querySelectorAll('[data-gallery-open]')) as HTMLButtonElement[];

    if (!viewport || !slides.length) return;

    let currentIndex = 0;
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let autoplayTimer: ReturnType<typeof setInterval> | null = null;
    const autoplayDelay = 5000;

    const startAutoplay = () => {
      if (prefersReducedMotion || slides.length < 2) return;
      stopAutoplay();
      autoplayTimer = setInterval(() => {
        if (lightbox && !lightbox.hidden) return;
        const idx = getIndex();
        scrollToIndex((idx + 1) % slides.length);
      }, autoplayDelay);
    };

    const stopAutoplay = () => {
      if (autoplayTimer) {
        clearInterval(autoplayTimer);
        autoplayTimer = null;
      }
    };

    const getIndex = () => {
      const width = viewport.clientWidth || 1;
      return Math.min(slides.length - 1, Math.max(0, Math.round(viewport.scrollLeft / width)));
    };

    const scrollToIndex = (index: number, smooth = true) => {
      const clamped = Math.min(slides.length - 1, Math.max(0, index));
      viewport.scrollTo({ left: clamped * viewport.clientWidth, behavior: smooth ? 'smooth' : 'auto' });
    };

    const updateThumbs = (index: number) => {
      thumbs.forEach((thumb, i) => {
        thumb.classList.toggle('is-active', i === index);
        thumb.setAttribute('aria-current', i === index ? 'true' : 'false');
      });
    };

    const updateControls = () => {
      const index = getIndex();
      currentIndex = index;
      if (previous) previous.disabled = index === 0;
      if (next) next.disabled = index === slides.length - 1;
      if (status) status.textContent = `Fotografía ${index + 1} de ${slides.length}`;
      updateThumbs(index);
    };

    const openLightbox = (index: number) => {
      stopAutoplay();
      if (!lightbox || !lightboxImage) return;
      const clamped = Math.min(slides.length - 1, Math.max(0, index));
      currentIndex = clamped;
      const slide = slides[clamped];
      const src = slide?.dataset.src || '';
      const alt = slide?.dataset.alt || '';
      lightboxImage.src = src;
      lightboxImage.alt = alt;
      if (lightboxCaption) lightboxCaption.textContent = `${clamped + 1} / ${slides.length}`;
      lightbox.hidden = false;
      lightbox.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      if (lightboxPrev) lightboxPrev.disabled = clamped === 0;
      if (lightboxNext) lightboxNext.disabled = clamped === slides.length - 1;
    };

    const closeLightbox = () => {
      if (!lightbox) return;
      lightbox.hidden = true;
      lightbox.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      startAutoplay();
    };

    const navigateLightbox = (delta: number) => {
      const nextIndex = Math.min(slides.length - 1, Math.max(0, currentIndex + delta));
      if (nextIndex !== currentIndex) openLightbox(nextIndex);
    };

    previous?.addEventListener('click', () => scrollToIndex(getIndex() - 1));
    next?.addEventListener('click', () => scrollToIndex(getIndex() + 1));
    viewport.addEventListener('scroll', updateControls, { passive: true });
    window.addEventListener('resize', updateControls);

    openButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const index = Number(button.dataset.index || '0');
        openLightbox(index);
      });
    });

    thumbs.forEach((thumb) => {
      thumb.addEventListener('click', () => {
        const index = Number(thumb.dataset.index || '0');
        openLightbox(index);
      });
    });

    lightboxClose?.addEventListener('click', closeLightbox);
    lightboxPrev?.addEventListener('click', () => navigateLightbox(-1));
    lightboxNext?.addEventListener('click', () => navigateLightbox(1));

    lightbox?.addEventListener('click', (event) => {
      if (event.target === lightbox) closeLightbox();
    });

    document.addEventListener('keydown', (event) => {
      if (lightbox?.hidden) return;
      if (event.key === 'Escape') closeLightbox();
      else if (event.key === 'ArrowLeft') navigateLightbox(-1);
      else if (event.key === 'ArrowRight') navigateLightbox(1);
    });

    gallery.addEventListener('mouseenter', stopAutoplay);
    gallery.addEventListener('mouseleave', startAutoplay);
    gallery.addEventListener('focusin', stopAutoplay);
    gallery.addEventListener('focusout', startAutoplay);
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) stopAutoplay();
      else startAutoplay();
    });

    updateControls();
    startAutoplay();
  });
</script>

<style>
  .project-gallery {
    position: relative;
  }

  .project-gallery__main {
    position: relative;
  }

  .project-gallery__viewport {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    overscroll-behavior-inline: contain;
  }

  .project-gallery__viewport::-webkit-scrollbar {
    display: none;
  }

  .project-gallery__slide {
    position: relative;
    width: 100%;
    min-width: 100%;
    aspect-ratio: 1.625;
    overflow: hidden;
    background: var(--color-cloud);
    scroll-snap-align: start;
  }

  .project-gallery__slide-button {
    display: block;
    width: 100%;
    height: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }

  .project-gallery__slide :global(picture),
  .project-gallery__slide :global(img) {
    width: 100%;
    height: 100%;
  }

  .project-gallery__slide :global(img) {
    object-fit: cover;
  }

  .project-gallery__controls {
    position: absolute;
    z-index: 2;
    inset: auto 20px 20px auto;
    display: flex;
    gap: 8px;
    align-items: center;
  }

  .project-gallery__controls button {
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 0;
    background: var(--color-ink);
    color: white;
    cursor: pointer;
    font-size: 20px;
    transition: background-color 150ms ease, opacity 150ms ease;
  }

  .project-gallery__controls button:hover:not(:disabled) {
    background: var(--color-accent);
  }

  .project-gallery__controls button:disabled {
    cursor: not-allowed;
    opacity: 0.45;
  }

  .project-gallery__status {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  .project-gallery__thumbs {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(84px, 1fr));
    gap: 10px;
    margin-top: 16px;
  }

  .project-gallery__thumb {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    border: 2px solid transparent;
    padding: 0;
    background: var(--color-cloud);
    cursor: pointer;
    transition: border-color 150ms ease, transform 150ms ease;
  }

  .project-gallery__thumb:hover,
  .project-gallery__thumb.is-active {
    border-color: var(--color-accent);
  }

  .project-gallery__thumb :global(picture),
  .project-gallery__thumb :global(img) {
    width: 100%;
    height: 100%;
  }

  .project-gallery__thumb :global(img) {
    object-fit: cover;
  }

  .project-gallery__lightbox {
    position: fixed;
    inset: 0;
    z-index: 1000;
    display: grid;
    place-items: center;
    padding: 24px;
    background: rgb(18 19 21 / 92%);
  }

  .project-gallery__lightbox[hidden] {
    display: none;
  }

  .project-gallery__lightbox-close {
    position: absolute;
    top: 20px;
    right: 20px;
    display: grid;
    width: 44px;
    height: 44px;
    place-items: center;
    border: 0;
    background: var(--color-ink);
    color: white;
    cursor: pointer;
    transition: background-color 150ms ease;
  }

  .project-gallery__lightbox-close:hover {
    background: var(--color-accent);
  }

  .project-gallery__lightbox-nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    border: 0;
    background: var(--color-ink);
    color: white;
    cursor: pointer;
    transition: background-color 150ms ease, opacity 150ms ease;
  }

  .project-gallery__lightbox-nav--prev {
    left: 20px;
  }

  .project-gallery__lightbox-nav--next {
    right: 20px;
  }

  .project-gallery__lightbox-nav:hover:not(:disabled) {
    background: var(--color-accent);
  }

  .project-gallery__lightbox-nav:disabled {
    cursor: not-allowed;
    opacity: 0.35;
  }

  .project-gallery__lightbox-figure {
    max-width: min(92vw, 1400px);
    max-height: 86vh;
    margin: 0;
    display: grid;
    gap: 12px;
    justify-items: center;
  }

  .project-gallery__lightbox-image {
    max-width: 100%;
    max-height: 80vh;
    width: auto;
    height: auto;
    object-fit: contain;
    background: var(--color-cloud);
  }

  .project-gallery__lightbox-caption {
    color: white;
    font-family: var(--font-heading);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  @media (max-width: 767px) {
    .project-gallery__slide {
      aspect-ratio: 1.05;
    }

    .project-gallery__controls {
      right: 12px;
      bottom: 12px;
    }

    .project-gallery__controls button {
      width: 40px;
      height: 40px;
    }

    .project-gallery__thumbs {
      grid-template-columns: repeat(auto-fill, minmax(64px, 1fr));
      gap: 8px;
    }

    .project-gallery__lightbox-nav {
      width: 40px;
      height: 40px;
    }

    .project-gallery__lightbox-nav--prev {
      left: 10px;
    }

    .project-gallery__lightbox-nav--next {
      right: 10px;
    }
  }
</style>