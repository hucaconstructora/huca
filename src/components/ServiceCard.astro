---
import { Picture } from 'astro:assets';
import ArrowUpRight from 'remixicon/icons/Arrows/arrow-right-up-line.svg';
import type { CollectionEntry } from 'astro:content';

interface Props {
  service: CollectionEntry<'services'>;
}

const { service } = Astro.props;
---

<article class="service-card">
  <a class="service-card__media" href={`/service/${service.data.slug}/`}>
    <Picture
      src={service.data.cover}
      alt={service.data.coverAlt}
      widths={[320, 480, 700, 1000]}
      sizes="(max-width: 700px) 100vw, (max-width: 1000px) 50vw, 33vw"
      formats={['avif', 'webp']}
      fallbackFormat="webp"
      fit="cover"
      loading="lazy"
    />
    <span class="service-card__icon" aria-hidden="true"><ArrowUpRight width={22} height={22} /></span>
  </a>
  <div class="service-card__body">
    <h3><a href={`/service/${service.data.slug}/`}>{service.data.title}</a></h3>
    <p>{service.data.tagline}</p>
    <a class="text-link" href={`/service/${service.data.slug}/`}>Ver servicio</a>
  </div>
</article>

<style>
  .service-card {
    border: 1px solid var(--color-line);
    background: white;
    box-shadow: 0 10px 34px rgb(18 19 21 / 4%);
    transition: transform 220ms ease, box-shadow 220ms ease;
  }

  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-soft);
  }

  .service-card__media {
    position: relative;
    display: block;
    aspect-ratio: 1.53;
    overflow: hidden;
    background: var(--color-cloud);
  }

  .service-card__media :global(picture),
  .service-card__media :global(img) {
    width: 100%;
    height: 100%;
  }

  .service-card__media :global(img) {
    object-fit: cover;
    transition: transform 550ms ease;
  }

  .service-card:hover .service-card__media :global(img) {
    transform: scale(1.04);
  }

  .service-card__icon {
    position: absolute;
    right: 0;
    bottom: 0;
    display: grid;
    width: 52px;
    height: 52px;
    place-items: center;
    background: var(--color-accent);
    color: white;
    font-size: 22px;
  }

  .service-card__body {
    display: grid;
    gap: 12px;
    padding: 24px;
  }

  .service-card h3 {
    font-size: 21px;
    line-height: 1.25;
  }

  .service-card h3 a:hover {
    color: var(--color-accent);
  }

  .service-card__body p {
    color: var(--color-copy);
    font-size: 15px;
    line-height: 1.55;
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card,
    .service-card__media :global(img) {
      transition: none;
    }
  }
</style>
