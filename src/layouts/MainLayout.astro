---
import type { ImageMetadata } from 'astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import { companyProfile } from '@/data/company';
import icon from '@/assets/site/logo-huca.svg';
import '../styles/global.css';
const defaultOgImage = '/og-image.png';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  ogImage?: ImageMetadata | string;
  ogType?: 'website' | 'article';
  breadcrumbs?: { label: string; href?: string }[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  noindex = false,
  ogImage,
  ogType = 'website',
  breadcrumbs = [],
  jsonLd,
} = Astro.props;
const origin = Astro.site?.origin ?? 'https://hucaconstructora.com';
const canonical = new URL(Astro.url.pathname, origin).href;
const iconUrl = new URL(icon.src, origin).href;
const imageUrl = new URL(
  typeof ogImage === 'string' ? ogImage : (ogImage ? ogImage.src : defaultOgImage),
  origin
).href;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${origin}/#organization`,
  name: companyProfile.legalName,
  alternateName: 'HUCA',
  url: origin,
  logo: iconUrl,
  image: iconUrl,
  email: companyProfile.email,
  telephone: '+34 671 774 262',
  priceRange: '€€',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Av. de la Pineda, 2',
    addressLocality: 'Castelldefels',
    addressRegion: 'Barcelona',
    postalCode: '08860',
    addressCountry: 'ES',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 41.2701,
    longitude: 1.9819,
  },
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '08:00',
    closes: '17:00',
  },
  sameAs: [],
};

const website = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${origin}/#website`,
  url: origin,
  name: 'HUCA Building Solutions',
  description: 'Obra civil y reformas integrales en Barcelona',
  publisher: { '@id': `${origin}/#organization` },
  inLanguage: 'es-ES',
};

const breadcrumbList = breadcrumbs.length > 0 ? {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: breadcrumbs.map((crumb, index) => ({
    '@type': 'ListItem',
    position: index + 1,
    name: crumb.label,
    ...(crumb.href ? { item: new URL(crumb.href, origin).href } : {}),
  })),
} : null;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="es" href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="icon" type="image/svg+xml" href={iconUrl} />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1e2023" />
    <link rel="dns-prefetch" href="https://tile.openstreetmap.org" />
    <title>{title}</title>
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="HUCA Building Solutions" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    {imageUrl && <meta property="og:image:width" content="1200" />}
    {imageUrl && <meta property="og:image:height" content="630" />}
    {imageUrl && <meta property="og:image:alt" content={title} />}
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    <script type="application/ld+json" set:html={JSON.stringify([organization, website, ...(breadcrumbList ? [breadcrumbList] : []), ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [])])}></script>
    {import.meta.env.PROD && (
      <script defer src="/umami.js" data-website-id="d8088b24-afd1-4ce1-9eb5-ad1d14838fc8" data-host-url="https://umami.qu4k3.com"></script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>
