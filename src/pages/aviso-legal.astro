---
import MainLayout from '../layouts/MainLayout.astro';
import ContentPlaceholder from '../components/ContentPlaceholder.astro';
---

<MainLayout title="Aviso legal | HUCA" description="Información legal de HUCA Building Solutions S.L." noindex={true}>
  <section class="legal-page section-pad">
    <div class="container">
      <h1>Aviso legal</h1>
      <ContentPlaceholder title="Texto legal pendiente de aprobación" description="Esta página no debe publicarse hasta incorporar el texto legal aprobado por HUCA." />
    </div>
  </section>
</MainLayout>

<style>
  .legal-page h1 { margin-bottom: 28px; font-size: clamp(32px, 4vw, 48px); }
</style>
