---
import MainLayout from '@/layouts/MainLayout.astro';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ContentPlaceholder from '@/components/ContentPlaceholder.astro';
import { aboutContent } from '@/data/company';
import heroContact from '@/assets/site/hero-contacto.jpg';
---

<MainLayout
  title="Quiénes somos | HUCA Building Solutions"
  description={aboutContent.introduction}
  ogImage={heroContact}
  breadcrumbs={[{ label: 'Inicio', href: '/' }, { label: 'Empresa' }, { label: 'Quiénes somos' }]}
>
  <PageHero
    eyebrow="HUCA Building Solutions"
    title="Quiénes somos"
    description={aboutContent.introduction}
    image={heroContact}
    imageAlt="Espacio de oficinas renovado con mamparas acristaladas y zona de trabajo."
    breadcrumbs={[{ label: 'Inicio', href: '/' }, { label: 'Empresa' }, { label: 'Quiénes somos' }]}
  />

  <section class="company-intro section-pad">
    <div class="container company-intro__grid">
      <div>
        <SectionHeading eyebrow="Quiénes somos" title="Una firma joven con sede en Barcelona" />
      </div>
      <div class="company-intro__copy">
        <p>{aboutContent.introduction}</p>
        <p>{aboutContent.description}</p>
      </div>
    </div>
  </section>

  <section class="company-values section-pad">
    <div class="container">
      <SectionHeading
        eyebrow="Nuestra propuesta de valor"
        title="Experiencia, innovación y una relación directa"
        description="La propuesta de HUCA se apoya en tres compromisos descritos por el equipo."
        align="center"
      />
      <div class="company-values__grid">
        {aboutContent.valueProposition.map((item, index) => (
          <article class="company-value">
            <span class="company-value__icon" aria-hidden="true">0{index + 1}</span>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="company-pending section-pad--compact">
    <div class="container company-pending__grid">
      <ContentPlaceholder
        title="Cifras de empresa y trayectoria"
        description="Pendiente de verificar indicadores como años de experiencia, número de proyectos o tamaño del equipo."
      />
      <ContentPlaceholder
        title="Logos de clientes y colaboradores"
        description="Añadir únicamente marcas con autorización de publicación."
      />
    </div>
  </section>
</MainLayout>

<style>
  .company-intro {
    background: #f2f2f2;
  }

  .company-intro__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(35px, 7vw, 100px);
    align-items: start;
  }

  .company-intro__copy {
    display: grid;
    gap: 18px;
    color: var(--color-copy);
    font-size: 16px;
    line-height: 1.72;
  }

  .company-values__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: 46px;
  }

  .company-value {
    min-height: 250px;
    padding: 30px;
    border: 1px solid var(--color-line);
    background: white;
  }

  .company-value__icon {
    display: grid;
    width: 48px;
    height: 48px;
    place-items: center;
    background: var(--color-accent);
    color: white;
    font-family: var(--font-heading);
    font-size: 14px;
    font-weight: 700;
  }

  .company-value h3 {
    margin: 21px 0 11px;
    font-size: 21px;
  }

  .company-value p {
    color: var(--color-copy);
    font-size: 15px;
    line-height: 1.65;
  }

  .company-pending {
    padding-top: 0;
  }

  .company-pending__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  @media (max-width: 760px) {
    .company-intro__grid,
    .company-values__grid,
    .company-pending__grid {
      grid-template-columns: 1fr;
    }

    .company-value {
      min-height: 0;
    }
  }
</style>
