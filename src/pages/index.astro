---
import { getCollection } from 'astro:content';
import MainLayout from '@/layouts/MainLayout.astro';
import ArrowRightUp from 'remixicon/icons/Arrows/arrow-right-up-line.svg';
import PageHero from '@/components/PageHero.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import ProjectCard from '@/components/ProjectCard.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import ContentPlaceholder from '@/components/ContentPlaceholder.astro';
import { aboutContent, companyValues } from '@/data/company';
import heroProjects from '@/assets/site/hero-proyectos.jpg';

const allProjects = (await getCollection('projects', ({ data }) => data.status === 'published'))
  .sort((a, b) => a.data.order - b.data.order);
const featured = allProjects.filter((project) => project.data.featured);
const homeProjects = (featured.length ? featured : allProjects).slice(0, 2);
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const partners = (await getCollection('partners', ({ data }) => data.featured !== false))
  .sort((a, b) => a.data.order - b.data.order);
const projectIntro = 'Nuestro diverso portafolio representa una pasión por la calidad, un servicio excepcional al cliente y un compromiso constante de acompañamiento en cada proyecto.';
---

<MainLayout
  title="HUCA Building Solutions | Obra civil y reformas en Barcelona"
  description={aboutContent.introduction}
  ogImage={heroProjects}
>
  <PageHero
    eyebrow="HUCA · BUILDING SOLUTIONS"
    title="Obras civiles y reformas integrales"
    description={aboutContent.introduction}
    image={heroProjects}
    imageAlt="Cocina reformada con mobiliario blanco y salida acristalada a una terraza."
    tone="dark"
  />

  <section class="home-welcome section-pad">
    <div class="container home-welcome__grid">
      <div class="home-welcome__copy">
        <SectionHeading
          eyebrow="Bienvenidos a HUCA"
          title="Construcción cuidada, cercana y responsable"
          description={aboutContent.introduction}
        />
        <p class="home-welcome__body">{aboutContent.description}</p>
        <a class="text-link" href="/empresa/">Conoce HUCA</a>
      </div>
      <aside class="home-welcome__panel" aria-label="Trayectoria de HUCA">
        <div class="home-welcome__year">2024</div>
        <p class="home-welcome__label">Inicio de actividad</p>
        <p>HUCA trabaja desde Barcelona en obras civiles y reformas integrales.</p>
        <ContentPlaceholder
          compact={true}
          title="Años de experiencia y cifras de empresa"
          description="Añadir solo indicadores comprobados por HUCA."
        />
      </aside>
    </div>
  </section>

  <section class="home-values section-pad">
    <div class="container">
      <SectionHeading
        eyebrow="Nuestra responsabilidad"
        title="Los principios que guían cada proyecto"
        description="En HUCA, trabajamos bajo principios que nos definen y que guían cada proyecto."
        align="center"
        light={true}
      />
      <div class="home-values__grid">
        {companyValues.slice(0, 3).map((value, index) => (
          <article class="home-value-card">
            <span class="home-value-card__number">0{index + 1}</span>
            <h3>{value.title}</h3>
            <p>{value.description}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="home-services section-pad">
    <div class="container">
      <SectionHeading
        eyebrow="Qué hacemos"
        title="Soluciones para cada etapa de la obra"
        description="Desde la obra nueva hasta las reformas, rehabilitaciones y proyectos de obra civil."
        align="center"
      />
      <div class="home-services__grid">
        {services.map((service) => <ServiceCard service={service} />)}
      </div>
      <div class="home-services__more">
        <a class="button button--outline" href="/servicios/">Ver todos los servicios <span class="button__arrow" aria-hidden="true"><ArrowRightUp width={20} height={20} /></span></a>
      </div>
    </div>
  </section>

  <section class="home-partners section-pad">
    <div class="container">
      <SectionHeading
        eyebrow="Confianza"
        title="Empresas colaboradoras"
        description="Proyectos desarrollados junto a empresas que confían en HUCA."
        align="center"
      />
      <div class="home-partners__grid">
        {partners.length > 0 ? partners.map((partner) => (
          <div class="home-partner" aria-label={partner.data.name}>
            <img src={partner.data.logo.src} alt={partner.data.logoAlt} loading="lazy" width={partner.data.logo.width} height={partner.data.logo.height} />
          </div>
        )) : (
          <ContentPlaceholder title="Empresas colaboradoras" description="Añade los logotipos desde Pages CMS para mostrarlos aquí." />
        )}
      </div>
    </div>
  </section>

  <section class="home-projects section-pad">
    <div class="container home-projects__grid">
      <div class="home-projects__intro">
        <SectionHeading
          eyebrow="Proyectos HUCA"
          title="Construimos soluciones proyecto a proyecto"
          description={projectIntro}
          light={true}
        />
        <a class="button" href="/proyectos/">Ver todos los proyectos <span class="button__arrow" aria-hidden="true"><ArrowRightUp width={20} height={20} /></span></a>
      </div>
      <div class="home-projects__cards">
        {homeProjects.map((project) => <ProjectCard project={project} size="narrow" />)}
        {homeProjects.length === 0 && (
          <ContentPlaceholder title="Proyectos destacados" description="Los proyectos aparecerán aquí cuando se publiquen desde el CMS." />
        )}
      </div>
    </div>
  </section>

  <section class="home-process section-pad">
    <div class="container">
      <SectionHeading
        eyebrow="Cómo trabajamos"
        title="Un proceso claro, de principio a fin"
        description="La estructura visual de esta sección sigue la referencia de diseño aprobada. Las etapas concretas de trabajo quedan pendientes de validación por HUCA."
        align="center"
      />
      <div class="home-process__steps">
        {['01', '02', '03', '04'].map((number) => (
          <article class="home-process__step">
            <span>{number}.</span>
            <h3>Contenido pendiente</h3>
            <p>Definir esta etapa con el equipo HUCA antes de publicar.</p>
          </article>
        ))}
      </div>
      <div class="home-process__placeholders">
        <ContentPlaceholder compact={true} title="Premios, certificaciones y cifras" description="Añadir nombres y datos verificables, o retirar estos bloques tras la revisión." />
        <ContentPlaceholder compact={true} title="Testimonios de clientes" description="Pendiente de testimonios autorizados para publicar." />
      </div>
    </div>
  </section>

</MainLayout>

<style>
  .home-welcome {
    background: linear-gradient(90deg, #f1f1f1 0, #f1f1f1 60%, white 60%);
  }

  .home-welcome__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(320px, 0.8fr);
    align-items: center;
    gap: clamp(40px, 7vw, 100px);
  }

  .home-welcome__copy {
    padding-block: 15px;
  }

  .home-welcome__body {
    max-width: 650px;
    margin-top: 19px;
    color: var(--color-copy);
    font-size: 16px;
    line-height: 1.7;
  }

  .home-welcome .text-link {
    margin-top: 25px;
  }

  .home-welcome__panel {
    display: grid;
    gap: 11px;
    padding: clamp(30px, 4.3vw, 56px);
    background: var(--color-charcoal);
    color: #e7e7e7;
    box-shadow: var(--shadow-soft);
  }

  .home-welcome__year {
    color: var(--color-accent);
    font-family: var(--font-heading);
    font-size: clamp(64px, 8vw, 98px);
    font-weight: 700;
    line-height: 0.95;
  }

  .home-welcome__label {
    color: white;
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .home-welcome__panel > p:not(.home-welcome__label) {
    margin-bottom: 8px;
    font-size: 15px;
    line-height: 1.65;
  }

  .home-values {
    background: var(--color-charcoal);
  }

  .home-values__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-top: 50px;
  }

  .home-value-card {
    min-height: 240px;
    padding: 30px;
    border: 1px solid rgb(255 255 255 / 20%);
    color: #c9c9c9;
  }

  .home-value-card__number {
    color: var(--color-accent);
    font-family: var(--font-heading);
    font-size: 24px;
    font-weight: 700;
  }

  .home-value-card h3 {
    margin: 18px 0 12px;
    color: white;
    font-size: 20px;
  }

  .home-value-card p {
    font-size: 15px;
    line-height: 1.65;
  }

  .home-services__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-top: 48px;
  }

  .home-services__more {
    display: flex;
    justify-content: center;
    margin-top: 38px;
  }

  .home-partners {
    background: var(--color-paper);
  }

  .home-partners__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 24px;
    align-items: center;
    margin-top: 48px;
  }

  .home-partner {
    display: grid;
    place-items: center;
    min-height: 96px;
    padding: 18px 20px;
    border: 1px solid var(--color-line);
    background: white;
    transition: border-color 180ms ease, box-shadow 180ms ease, transform 180ms ease;
  }

  .home-partner:hover {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-soft);
    transform: translateY(-2px);
  }

  .home-partner img {
    max-width: 100%;
    max-height: 56px;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: grayscale(1) opacity(0.72);
    transition: filter 180ms ease;
  }

  .home-partner:hover img {
    filter: grayscale(0) opacity(1);
  }

  .home-projects {
    background: var(--color-charcoal);
  }

  .home-projects__grid {
    display: grid;
    grid-template-columns: minmax(280px, 0.82fr) minmax(0, 1.18fr);
    align-items: center;
    gap: clamp(38px, 6vw, 80px);
  }

  .home-projects__intro {
    display: grid;
    justify-items: start;
    gap: 30px;
  }

  .home-projects__cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 14px;
  }

  .home-projects__cards .project-card__media {
    min-height: 0;
    aspect-ratio: 0.82;
  }

  .home-process__steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin-top: 45px;
  }

  .home-process__step {
    min-height: 210px;
    padding: 24px;
    border: 1px solid var(--color-line);
    background: white;
    text-align: center;
  }

  .home-process__step > span {
    color: var(--color-accent);
    font-family: var(--font-heading);
    font-size: 34px;
    font-weight: 700;
  }

  .home-process__step h3 {
    margin: 14px 0 8px;
    font-size: 17px;
  }

  .home-process__step p {
    font-size: 14px;
    line-height: 1.5;
  }

  .home-process__placeholders {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    margin-top: 24px;
  }

  @media (max-width: 980px) {
    .home-welcome__grid,
    .home-projects__grid {
      grid-template-columns: 1fr;
    }

    .home-welcome {
      background: #f1f1f1;
    }

    .home-welcome__panel {
      max-width: 620px;
    }

    .home-projects__cards .project-card__media {
      min-height: 0;
      aspect-ratio: 0.92;
    }
  }

  @media (max-width: 760px) {
    .home-values__grid,
    .home-services__grid {
      grid-template-columns: 1fr;
    }

    .home-process__steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .home-projects__cards {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .home-projects__cards .project-card__media {
      aspect-ratio: 0.82;
    }

    .home-process__placeholders {
      grid-template-columns: 1fr;
    }

  }

  @media (max-width: 480px) {
    .home-projects__cards {
      grid-template-columns: 1fr;
    }

    .home-projects__cards .project-card__media {
      aspect-ratio: 1.05;
    }

    .home-process__steps {
      grid-template-columns: 1fr;
    }
  }
</style>
