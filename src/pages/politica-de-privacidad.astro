---
import MainLayout from '@/layouts/MainLayout.astro';
import ContentPlaceholder from '@/components/ContentPlaceholder.astro';
---

<MainLayout title="Política de privacidad | HUCA" description="Información sobre el tratamiento de datos personales por HUCA." noindex={true}>
  <section class="legal-page section-pad">
    <div class="container">
      <h1>Política de privacidad</h1>
      <ContentPlaceholder title="Texto legal pendiente de aprobación" description="Esta página no debe publicarse hasta incorporar el texto de privacidad aprobado por HUCA." />
    </div>
  </section>
</MainLayout>

<style>
  .legal-page h1 { margin-bottom: 28px; font-size: clamp(32px, 4vw, 48px); }
</style>
