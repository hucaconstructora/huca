---
import MainLayout from '../layouts/MainLayout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ContentPlaceholder from '../components/ContentPlaceholder.astro';
import { companyValues } from '../data/company';
import heroProjects from '../assets/site/hero-proyectos.jpg';

const introduction = 'En HUCA, trabajamos bajo principios que nos definen y que guían cada proyecto.';
---

<MainLayout
  title="Por qué elegir HUCA | Nuestros valores"
  description={introduction}
  ogImage={heroProjects}
  noindex={true}
  breadcrumbs={[{ label: 'Inicio', href: '/' }, { label: 'Empresa', href: '/empresa/' }, { label: 'Por qué elegirnos' }]}
>
  <PageHero
    eyebrow="Responsabilidad y confianza"
    title="Por qué elegir HUCA"
    description={introduction}
    image={heroProjects}
    imageAlt="Interior de una vivienda reformada por HUCA, con cocina abierta y salida acristalada."
    breadcrumbs={[{ label: 'Inicio', href: '/' }, { label: 'Empresa', href: '/empresa/' }, { label: 'Por qué elegirnos' }]}
  />

  <section class="reasons section-pad">
    <div class="container">
      <SectionHeading
        eyebrow="Nuestros valores"
        title="Principios que guían cada proyecto"
        description={introduction}
        align="center"
      />
      <div class="reasons__grid">
        {companyValues.map((value, index) => (
          <article class="reason-card">
            <span class="reason-card__icon" aria-hidden="true">0{index + 1}</span>
            <div>
              <h3>{value.title}</h3>
              <p>{value.description}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="reasons-pending section-pad--compact">
    <div class="container reasons-pending__grid">
      <ContentPlaceholder
        title="Premios y certificaciones"
        description="Añadir los nombres, entidades y años de las certificaciones o premios que HUCA autorice a publicar."
      />
      <ContentPlaceholder
        title="Testimonios de clientes"
        description="Pendiente de recibir testimonios aprobados y autorización para publicarlos."
      />
      <ContentPlaceholder
        title="Garantías y datos verificables"
        description="No se han reproducido cifras, empleados, proyectos ni años de experiencia de terceros sin verificación."
      />
    </div>
  </section>
</MainLayout>

<style>
  .reasons__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin-top: 48px;
  }

  .reason-card {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 20px;
    align-items: start;
    min-height: 180px;
    padding: 27px;
    border: 1px solid var(--color-line);
    background: white;
  }

  .reason-card__icon {
    display: grid;
    width: 52px;
    height: 52px;
    place-items: center;
    background: var(--color-accent);
    color: white;
    font-family: var(--font-heading);
    font-size: 15px;
    font-weight: 700;
  }

  .reason-card h3 {
    margin: 2px 0 9px;
    font-size: 20px;
  }

  .reason-card p {
    color: var(--color-copy);
    font-size: 15px;
    line-height: 1.6;
  }

  .reasons-pending__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 16px;
  }

  @media (max-width: 760px) {
    .reasons__grid,
    .reasons-pending__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .reason-card {
      grid-template-columns: 1fr;
      gap: 14px;
    }
  }
</style>
