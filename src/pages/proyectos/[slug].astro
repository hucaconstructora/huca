---
import { getCollection, type CollectionEntry } from 'astro:content';
import MainLayout from '../../layouts/MainLayout.astro';
import PageHero from '../../components/PageHero.astro';
import ProjectGallery from '../../components/ProjectGallery.astro';
import FormattedText from '../../components/FormattedText.astro';
import { companyProfile } from '../../data/company';
import ArrowLeft from 'remixicon/icons/Arrows/arrow-left-line.svg';
import ArrowRight from 'remixicon/icons/Arrows/arrow-right-line.svg';
import Grid3x3 from 'remixicon/icons/Design/layout-grid-line.svg';

type Project = CollectionEntry<'projects'>;
interface Props {
  project: Project;
  previous?: { slug: string; title: string };
  next?: { slug: string; title: string };
}

export async function getStaticPaths() {
  const projects = (await getCollection('projects', ({ data }) => data.status === 'published'))
    .sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, 'es'));

  return projects.map((project, index) => ({
    params: { slug: project.data.slug },
    props: {
      project,
      previous: projects[index - 1]
        ? { slug: projects[index - 1].data.slug, title: projects[index - 1].data.title }
        : undefined,
      next: projects[index + 1]
        ? { slug: projects[index + 1].data.slug, title: projects[index + 1].data.title }
        : undefined,
    },
  }));
}

const { project, previous, next } = Astro.props as Props;
const data = project.data;
const metadata = [
  { label: 'Cliente', value: data.client ?? '—' },
  { label: 'Región', value: data.region ?? '—' },
  { label: 'Ciudad', value: data.city ?? data.location },
  { label: 'Presupuesto', value: data.budget ?? '—' },
  { label: 'Año', value: String(data.year) },
  { label: 'Superficie', value: data.builtAreaM2 ? `${data.builtAreaM2.toLocaleString('es-ES')} m²` : '—' },
  { label: 'Sector', value: data.sector ?? '—' },
  { label: 'Subsector', value: data.subSector ?? '—' },
];
const seoTitle = data.seoTitle ?? `${data.title} | ${companyProfile.name}`;
const seoDescription = data.seoDescription ?? data.summary;
---

<MainLayout title={seoTitle} description={seoDescription} ogType="article" ogImage={data.cover}>
  <PageHero
    eyebrow="Descubre el trabajo que hemos realizado"
    title={data.title}
    description={data.summary}
    image={data.cover}
    imageAlt={data.coverAlt}
    breadcrumbs={[{ label: 'Inicio', href: '/' }, { label: 'Proyectos', href: '/proyectos/' }, { label: data.title }]}
  />

  <article class="project-detail section-pad">
    <div class="container project-detail__container">
      <header class="project-detail__header">
        <h2>{data.title}</h2>
        <p class="project-detail__type">{data.projectType}</p>
      </header>

      <dl class="project-meta">
        {metadata.map((item) => (
          <div class="project-meta__item">
            <dt>{item.label}</dt>
            <dd>{item.value}</dd>
          </div>
        ))}
      </dl>

      <ProjectGallery project={project} />

      <div class="project-detail__copy">
        <section class="project-detail__section">
          <h2>Sobre el proyecto</h2>
          <FormattedText text={data.description} />
        </section>
        {data.challenge && (
          <section class="project-detail__section">
            <h2>Desafío del cliente</h2>
            <FormattedText text={data.challenge} />
          </section>
        )}
        {data.approach && (
          <section class="project-detail__section">
            <h2>Enfoque y solución</h2>
            <FormattedText text={data.approach} />
          </section>
        )}
      </div>

      <nav class="project-navigation" aria-label="Navegación entre proyectos">
        {previous
          ? <a class="project-navigation__item" href={`/proyectos/${previous.slug}/`}><span class="project-navigation__arrow" aria-hidden="true"><ArrowLeft width={18} height={18} /></span><span><small>Proyecto anterior</small><strong>{previous.title}</strong></span></a>
          : <span class="project-navigation__item project-navigation__item--empty"></span>}
        <a class="project-navigation__all" href="/proyectos/" aria-label="Volver a todos los proyectos"><Grid3x3 width={20} height={20} aria-hidden="true" /></a>
        {next
          ? <a class="project-navigation__item project-navigation__item--next" href={`/proyectos/${next.slug}/`}><span><small>Proyecto siguiente</small><strong>{next.title}</strong></span><span class="project-navigation__arrow" aria-hidden="true"><ArrowRight width={18} height={18} /></span></a>
          : <span class="project-navigation__item project-navigation__item--empty"></span>}
      </nav>
    </div>
  </article>
</MainLayout>

<style>
  .project-detail {
    background: white;
  }

  .project-detail__container {
    max-width: 1100px;
  }

  .project-detail__header {
    margin-bottom: 34px;
    text-align: center;
  }

  .project-detail__header h2 {
    font-size: clamp(28px, 3.2vw, 43px);
  }

  .project-detail__type {
    margin-top: 12px;
    color: var(--color-accent);
    font-family: var(--font-heading);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .project-meta {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0 24px;
    margin: 0 0 38px;
  }

  .project-meta__item {
    min-height: 82px;
    padding: 16px 0;
    border-top: 1px solid var(--color-line);
  }

  .project-meta dt {
    margin-bottom: 6px;
    color: #929292;
    font-size: 14px;
  }

  .project-meta dd {
    margin: 0;
    color: var(--color-ink);
    font-family: var(--font-heading);
    font-size: 17px;
    font-weight: 600;
  }

  .project-detail__copy {
    margin-top: 42px;
  }

  .project-detail__section {
    padding: 28px 0;
    border-bottom: 1px solid var(--color-line);
  }

  .project-detail__section h2 {
    margin-bottom: 14px;
    font-size: 26px;
  }

  .project-navigation {
    display: grid;
    grid-template-columns: 1fr 52px 1fr;
    align-items: center;
    gap: 20px;
    margin-top: 44px;
  }

  .project-navigation__item {
    display: flex;
    align-items: center;
    gap: 13px;
    color: var(--color-ink);
  }

  .project-navigation__arrow {
    display: grid;
    width: 44px;
    height: 44px;
    flex: 0 0 44px;
    place-items: center;
    background: var(--color-ink);
    color: white;
    font-size: 20px;
  }

  .project-navigation__item small,
  .project-navigation__item strong {
    display: block;
  }

  .project-navigation__item small {
    margin-bottom: 4px;
    color: #888;
    font-family: var(--font-heading);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .project-navigation__item strong {
    font-size: 13px;
    line-height: 1.3;
  }

  .project-navigation__item:hover strong {
    color: var(--color-accent);
  }

  .project-navigation__item--next {
    justify-content: flex-end;
    text-align: right;
  }

  .project-navigation__all {
    display: grid;
    width: 46px;
    height: 46px;
    place-items: center;
    color: var(--color-accent);
    font-size: 25px;
  }

  .project-navigation__item--empty {
    min-height: 44px;
  }

  @media (max-width: 720px) {
    .project-meta {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0 18px;
    }

    .project-navigation {
      grid-template-columns: 1fr 42px 1fr;
      gap: 8px;
    }

    .project-navigation__item strong {
      display: none;
    }

    .project-navigation__arrow {
      width: 40px;
      height: 40px;
      flex-basis: 40px;
    }
  }
</style>
